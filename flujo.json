{
  "nodes": [
    {
      "parameters": {
        "cronExpression": "0 0 * * *"
      },
      "name": "Renovar Token Cada Día",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1
    },
    {
      "parameters": {
        "functionCode": "if (new Date().getTime() > new Date(expiresAt).getTime()) { return $json(1); } else { return $json(2); }"
      },
      "name": "Verificar Token",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1
    },
    {
      "parameters": {
        "url": "https://graph.facebook.com/v18.0/oauth/access_token?grant_type=fb_exchange_token&client_id=YOUR_CLIENT_ID&client_secret=YOUR_CLIENT_SECRET&fb_exchange_token={{ $json[\"access_token\"] }}",
        "method": "GET"
      },
      "name": "Renovar Token Facebook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2
    }
  ],
  "connections": {
    "Renovar Token Cada Día": {
      "main": [
        [
          {
            "node": "Verificar Token",
            "type": "main",
            "index": 0
          }
        ]
      }
    },
    "Verificar Token": {
      "main": [
        [
          {
            "node": "Renovar Token Facebook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  ]
}
